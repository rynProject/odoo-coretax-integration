<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coretax_send_wizard_form" model="ir.ui.view">
        <field name="name">coretax.send.wizard.form</field>
        <field name="model">coretax.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Kirim e-Faktur">
                <field name="step" invisible="1"/>
                <field name="connection_ready" invisible="1"/>

                <!-- langkah 1: periksa -->
                <div attrs="{'invisible': [('step', '!=', 'check')]}">
                    <div attrs="{'invisible': [('connection_ready', '!=', False)]}" class="alert alert-danger d-flex justify-content-between align-items-center" role="alert">
                        <span><i title="Koneksi" class="fa fa-plug"/> <field name="connection_message" class="d-inline" readonly="1"/></span>
                        <button name="action_open_connection" type="object" string="Atur koneksi" class="btn-secondary btn-sm"
                                groups="coretax_integration.group_coretax_manager"/>
                    </div>
                    <div attrs="{'invisible': ['|', ('connection_ready', '=', False), ('connection_message', '=', False)]}" class="alert alert-warning" role="status">
                        <i title="Perhatian" class="fa fa-exclamation-circle"/> <field name="connection_message" class="d-inline" readonly="1"/>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span attrs="{'invisible': [('ready_count', '=', False)]}" class="badge rounded-pill text-bg-success fs-6">
                            <i title="Siap" class="fa fa-check"/> <field name="ready_count" class="d-inline"/> siap
                        </span>
                        <span attrs="{'invisible': [('warning_count', '=', False)]}" class="badge rounded-pill text-bg-warning fs-6">
                            <i title="Catatan" class="fa fa-exclamation"/> <field name="warning_count" class="d-inline"/> siap, ada catatan
                        </span>
                        <span attrs="{'invisible': [('blocked_count', '=', False)]}" class="badge rounded-pill text-bg-danger fs-6">
                            <i title="Belum bisa dikirim" class="fa fa-ban"/> <field name="blocked_count" class="d-inline"/> belum bisa dikirim
                        </span>
                    </div>
                    <group>
                        <field name="mode" widget="radio"/>
                    </group>
                </div>

                <!-- langkah 2: hasil -->
                <div attrs="{'invisible': [('step', '!=', 'done')]}">
                    <div attrs="{'invisible': [('sent_count', '=', False)]}" class="alert alert-success" role="status">
                        <i title="Berhasil" class="fa fa-check-circle"/> <field name="sent_count" class="d-inline fw-bold"/> e-Faktur berhasil dikirim.
                        Hasil dari DJP akan diperbarui otomatis.
                    </div>
                    <div attrs="{'invisible': [('failed_count', '=', False)]}" class="alert alert-danger" role="alert">
                        <i title="Perlu tindakan" class="fa fa-exclamation-triangle"/> <field name="failed_count" class="d-inline fw-bold"/> e-Faktur gagal -
                        lihat keterangannya di bawah. Setelah diperbaiki, kirim ulang dari faktur atau menu <b>Perlu tindakan</b>.
                    </div>
                </div>

                <field name="line_ids" readonly="1" nolabel="1">
                    <tree create="0" delete="0" decoration-danger="level == 'error' or result == 'failed'"
                          decoration-warning="level == 'warning' and not result" decoration-success="result in ('sent', 'draft')">
                        <field name="move_id"/>
                        <field name="partner_id"/>
                        <field name="invoice_date" optional="show"/>
                        <field name="amount_total"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="level" attrs="{'column_invisible': [('parent.step', '=', 'done')]}" widget="badge"
                               decoration-success="level == 'ok'" decoration-warning="level == 'warning'" decoration-danger="level == 'error'"/>
                        <field name="messages" attrs="{'column_invisible': [('parent.step', '=', 'done')]}"/>
                        <field name="result" attrs="{'column_invisible': [('parent.step', '!=', 'done')]}" widget="badge"
                               decoration-success="result in ('sent', 'draft')" decoration-danger="result == 'failed'"/>
                        <field name="result_message" attrs="{'column_invisible': [('parent.step', '!=', 'done')]}"/>
                        <field name="needs_match" invisible="1"/>
                        <button name="action_match_partner" attrs="{'invisible': [('needs_match', '=', False)], 'column_invisible': [('parent.step', '!=', 'done')]}" type="object" string="Cocokkan pelanggan" icon="fa-link"
                                class="btn-link"/>
                        <button name="action_open_move" type="object" icon="fa-external-link" title="Buka faktur"/>
                    </tree>
                </field>

                <footer>
                    <button name="action_send" attrs="{'invisible': [('step', '!=', 'check')]}" type="object" string="Kirim sekarang" class="btn-primary" icon="fa-paper-plane"/>
                    <button attrs="{'invisible': [('step', '!=', 'check')]}" special="cancel" string="Batal"/>
                    <button name="action_view_results" attrs="{'invisible': [('step', '!=', 'done')]}" type="object" string="Lihat e-Faktur" class="btn-primary"/>
                    <button attrs="{'invisible': [('step', '!=', 'done')]}" special="cancel" string="Tutup"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_coretax_partner_match_wizard_form" model="ir.ui.view">
        <field name="name">coretax.partner.match.wizard.form</field>
        <field name="model">coretax.partner.match.wizard</field>
        <field name="arch" type="xml">
            <form string="Cocokkan dengan PajakMu">
                <group>
                    <group>
                        <field name="partner_id" readonly="1"/>
                        <field name="partner_identity"/>
                    </group>
                    <group>
                        <field name="current_counterparty" attrs="{'invisible': [('current_counterparty', '=', False)]}"/>
                    </group>
                </group>
                <div class="d-flex gap-2 align-items-center mb-3">
                    <field name="search_term" placeholder="NPWP atau nama di PajakMu" class="flex-grow-1"/>
                    <button name="action_search" type="object" string="Cari" class="btn-primary" icon="fa-search"/>
                </div>
                <div attrs="{'invisible': [('message', '=', False)]}" class="alert alert-warning" role="status">
                    <field name="message" readonly="1"/>
                </div>
                <field name="line_ids" attrs="{'invisible': [('line_ids', '=', False)]}" readonly="1" nolabel="1">
                    <tree create="0" delete="0" decoration-success="same_id">
                        <field name="nama"/>
                        <field name="npwp"/>
                        <field name="jenis_id" optional="hide"/>
                        <field name="vswp_status"/>
                        <field name="same_id" widget="boolean" string="NPWP sama"/>
                        <button name="action_choose" type="object" string="Pilih ini" class="btn-primary btn-sm" icon="fa-link"/>
                    </tree>
                </field>
                <footer>
                    <field name="searched" invisible="1"/>
                    <button name="action_register" attrs="{'invisible': ['|', ('searched', '=', False), ('line_ids', '!=', False)]}" type="object" string="Daftarkan dari Odoo" icon="fa-user-plus"
                            class="btn-primary"/>
                    <button name="action_register" attrs="{'invisible': ['|', ('searched', '=', False), ('line_ids', '=', False)]}" type="object" string="Daftarkan dari Odoo" icon="fa-user-plus"/>
                    <button special="cancel" string="Tutup"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_coretax_partner_register_wizard_form" model="ir.ui.view">
        <field name="name">coretax.partner.register.wizard.form</field>
        <field name="model">coretax.partner.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Daftarkan ke PajakMu">
                <field name="step" invisible="1"/>

                <!-- langkah 1: periksa -->
                <div attrs="{'invisible': [('step', '!=', 'check')]}">
                    <p class="text-muted">Kontak yang datanya lengkap didaftarkan sebagai <b>Lawan Transaksi</b> di PajakMu.
                        NPWP yang ternyata sudah terdaftar langsung ditautkan ke data yang ada.</p>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span attrs="{'invisible': [('ready_count', '=', False)]}" class="badge rounded-pill text-bg-success fs-6">
                            <i title="Siap" class="fa fa-check"/> <field name="ready_count" class="d-inline"/> siap
                        </span>
                        <span attrs="{'invisible': [('matched_count', '=', False)]}" class="badge rounded-pill text-bg-secondary fs-6">
                            <i title="Sudah tertaut" class="fa fa-link"/> <field name="matched_count" class="d-inline"/> sudah tertaut
                        </span>
                        <span attrs="{'invisible': [('blocked_count', '=', False)]}" class="badge rounded-pill text-bg-danger fs-6">
                            <i title="Belum lengkap" class="fa fa-ban"/> <field name="blocked_count" class="d-inline"/> data belum lengkap
                        </span>
                    </div>
                </div>

                <!-- langkah 2: hasil -->
                <div attrs="{'invisible': [('step', '!=', 'done')]}">
                    <div attrs="{'invisible': [('registered_count', '=', False)]}" class="alert alert-success" role="status">
                        <i title="Berhasil" class="fa fa-check-circle"/> <field name="registered_count" class="d-inline fw-bold"/>
                        kontak kini tertaut ke Lawan Transaksi PajakMu.
                    </div>
                    <div attrs="{'invisible': [('failed_count', '=', False)]}" class="alert alert-danger" role="alert">
                        <i title="Perlu tindakan" class="fa fa-exclamation-triangle"/> <field name="failed_count" class="d-inline fw-bold"/>
                        kontak gagal didaftarkan - lihat keterangannya di bawah.
                    </div>
                </div>

                <field name="line_ids" readonly="1" nolabel="1">
                    <tree create="0" delete="0" decoration-danger="level == 'error' or result == 'failed'"
                          decoration-muted="level == 'matched'" decoration-success="result in ('created', 'linked')">
                        <field name="partner_id"/>
                        <field name="identity"/>
                        <field name="level" attrs="{'column_invisible': [('parent.step', '=', 'done')]}" widget="badge"
                               decoration-success="level == 'ok'" decoration-danger="level == 'error'"/>
                        <field name="messages" attrs="{'column_invisible': [('parent.step', '=', 'done')]}"/>
                        <field name="result" attrs="{'column_invisible': [('parent.step', '!=', 'done')]}" widget="badge"
                               decoration-success="result in ('created', 'linked')" decoration-danger="result == 'failed'"/>
                        <field name="result_message" attrs="{'column_invisible': [('parent.step', '!=', 'done')]}"/>
                        <button name="action_open_partner" type="object" icon="fa-external-link" title="Buka kontak"/>
                    </tree>
                </field>

                <footer>
                    <button name="action_register" attrs="{'invisible': [('step', '!=', 'check')]}" type="object" string="Daftarkan sekarang" class="btn-primary"
                            icon="fa-user-plus"/>
                    <button attrs="{'invisible': [('step', '!=', 'check')]}" special="cancel" string="Batal"/>
                    <button attrs="{'invisible': [('step', '!=', 'done')]}" special="cancel" string="Tutup"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_coretax_faktur_cancel_wizard_form" model="ir.ui.view">
        <field name="name">coretax.faktur.cancel.wizard.form</field>
        <field name="model">coretax.faktur.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Batalkan e-Faktur">
                <div class="alert alert-warning" role="status">
                    Pembatalan diajukan ke DJP dan tidak bisa ditarik kembali. Tulis alasan yang jelas (minimal 5 karakter).
                </div>
                <group>
                    <field name="faktur_id" readonly="1" options="{'no_open': True}"/>
                    <field name="alasan" placeholder="Contoh: Salah harga satuan"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Ajukan pembatalan" class="btn-primary"/>
                    <button string="Tutup" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_coretax_retur_wizard_form" model="ir.ui.view">
        <field name="name">coretax.retur.wizard.form</field>
        <field name="model">coretax.retur.wizard</field>
        <field name="arch" type="xml">
            <form string="Kirim nota retur">
                <div class="alert alert-info" role="status">
                    Nota retur meretur faktur masukan yang sudah ada di PajakMu, per barang/jasa. Periksa nilai retur
                    di bawah; nilainya tidak boleh melebihi sisa faktur asal.
                </div>
                <div attrs="{'invisible': [('lookup_message', '=', False)]}" class="alert alert-warning" role="alert">
                    <field name="lookup_message"/>
                </div>
                <group>
                    <group>
                        <field name="move_id" readonly="1" options="{'no_open': True}"/>
                        <label for="nomor_faktur"/>
                        <div class="o_row">
                            <field name="nomor_faktur"/>
                            <button name="action_lookup" type="object" string="Cari ulang" icon="fa-search"
                                    class="btn-link"/>
                        </div>
                        <field name="faktur_masukan_info" attrs="{'invisible': [('faktur_masukan_id', '=', False)]}"/>
                        <field name="is_creditable"/>
                    </group>
                    <group>
                        <field name="nomor_dokumen_retur" placeholder="Kosongkan agar diberi nomor oleh PajakMu"/>
                        <field name="tanggal_retur"/>
                        <field name="referensi"/>
                        <field name="faktur_masukan_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids" attrs="{'invisible': [('faktur_masukan_id', '=', False)]}">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="index" invisible="1"/>
                        <field name="nama"/>
                        <field name="satuan" optional="hide"/>
                        <field name="sisa_jumlah" optional="show"/>
                        <field name="retur_jumlah"/>
                        <field name="sisa_dpp" optional="show"/>
                        <field name="retur_dpp"/>
                        <field name="retur_diskon" optional="hide"/>
                        <field name="retur_dpp_lain" optional="show"/>
                        <field name="retur_ppn"/>
                        <field name="retur_ppnbm" optional="hide"/>
                        <field name="sisa_diskon" invisible="1"/>
                        <field name="sisa_dpp_lain" invisible="1"/>
                        <field name="sisa_ppn" invisible="1"/>
                        <field name="sisa_ppnbm" invisible="1"/>
                    </tree>
                </field>
                <group attrs="{'invisible': [('faktur_masukan_id', '=', False)]}">
                    <group/>
                    <group>
                        <field name="total_dpp"/>
                        <field name="total_ppn"/>
                        <field name="total_ppnbm"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" attrs="{'invisible': [('faktur_masukan_id', '=', False)]}" type="object" string="Kirim nota retur" class="btn-primary"/>
                    <button string="Tutup" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_coretax_retur_cancel_wizard_form" model="ir.ui.view">
        <field name="name">coretax.retur.cancel.wizard.form</field>
        <field name="model">coretax.retur.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Batalkan nota retur">
                <div class="alert alert-warning" role="status">
                    Pembatalan diajukan ke DJP dan tidak bisa ditarik kembali. Tulis alasan yang jelas (minimal 5 karakter).
                </div>
                <group>
                    <field name="retur_id" readonly="1" options="{'no_open': True}"/>
                    <field name="alasan" placeholder="Contoh: Salah nilai retur"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Ajukan pembatalan" class="btn-primary"/>
                    <button string="Tutup" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
