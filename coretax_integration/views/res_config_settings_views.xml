<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Blok di Pengaturan Akuntansi supaya integrasinya mudah ditemukan. -->
    <record id="res_config_settings_view_form_coretax" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.coretax</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Coretax" string="Coretax (PajakMu)" name="coretax_integration"
                     groups="coretax_integration.group_coretax_manager">
                    <block title="Coretax (PajakMu)" name="coretax_block">
                        <setting string="Koneksi PajakMu" help="Kirim e-Faktur dan bukti potong ke DJP lewat PajakMu; status DJP kembali ke Odoo otomatis.">
                            <button name="%(coretax_integration.action_coretax_connection_open)d" type="action"
                                    string="Atur koneksi PajakMu" class="btn-link" icon="oi-arrow-right"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
