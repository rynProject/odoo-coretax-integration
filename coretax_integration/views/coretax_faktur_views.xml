<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coretax_faktur_search" model="ir.ui.view">
        <field name="name">coretax.faktur.search</field>
        <field name="model">coretax.faktur</field>
        <field name="arch" type="xml">
            <search string="Cari e-Faktur">
                <field name="name" string="e-Faktur / Nomor Faktur Pajak"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <filter name="attention" string="Perlu tindakan" domain="[('attention', '=', True)]"/>
                <filter name="in_progress" string="Sedang diproses" domain="[('in_progress', '=', True)]"/>
                <filter name="approved" string="Disetujui DJP" domain="[('state', '=', 'approved')]"/>
                <filter name="draft" string="Draft di PajakMu" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="this_month" string="Bulan ini"
                        domain="[('invoice_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="invoice_date" string="Tanggal faktur" date="invoice_date"/>
                <field name="masa_pajak" string="Masa pajak"/>
                <field name="tahun_pajak" string="Tahun pajak"/>
                <separator/>
                <filter name="archived" string="Riwayat versi lama" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Pelanggan" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Bulan faktur" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_coretax_faktur_list" model="ir.ui.view">
        <field name="name">coretax.faktur.list</field>
        <field name="model">coretax.faktur</field>
        <field name="arch" type="xml">
            <tree string="e-Faktur" create="0" decoration-danger="attention" decoration-success="state == 'approved'"
                  decoration-info="in_progress" decoration-muted="state in ('cancelled', 'replaced')">
                <field name="company_id" invisible="1"/>
                <field name="attention" invisible="1"/>
                <field name="in_progress" invisible="1"/>
                <field name="invoice_date"/>
                <field name="move_id" string="Faktur Odoo"/>
                <field name="partner_id"/>
                <field name="nomor_faktur" optional="show"/>
                <field name="total_dpp" sum="Total DPP" optional="show"/>
                <field name="total_ppn" sum="Total PPN" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"
                       decoration-danger="state in ('rejected', 'error')" decoration-info="state in ('submitted', 'processing')"
                       decoration-warning="state in ('draft', 'pending_approval', 'validated', 'cancel_requested')"/>
                <field name="last_error" optional="show" string="Keterangan"/>
                <field name="write_date" string="Diperbarui" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_coretax_faktur_kanban" model="ir.ui.view">
        <field name="name">coretax.faktur.kanban</field>
        <field name="model">coretax.faktur</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" create="0" group_create="0" group_delete="0" group_edit="0"
                    records_draggable="0" quick_create="0">
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="attention"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="move_id" class="fw-bold"/>
                            <field name="invoice_date" class="text-muted"/>
                        </div>
                        <field name="partner_id" class="text-truncate"/>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="text-muted">PPN <field name="total_ppn" widget="monetary"/></span>
                            <field name="nomor_faktur" class="small"/>
                        </div>
                        <div t-if="record.attention.raw_value" class="text-danger small mt-1 text-truncate">
                            <i title="Perhatian" class="fa fa-exclamation-circle"/> <field name="last_error"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_coretax_faktur_form" model="ir.ui.view">
        <field name="name">coretax.faktur.form</field>
        <field name="model">coretax.faktur</field>
        <field name="arch" type="xml">
            <form string="e-Faktur" create="0">
                <header>
                    <button name="action_send_to_djp" attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'validated']), ('aksatax_id', '=', False)]}" type="object" string="Kirim ke DJP" class="btn-primary" icon="fa-paper-plane"
                            confirm="Kirim e-Faktur ini ke DJP sekarang?"/>
                    <button name="action_refresh" attrs="{'invisible': [('aksatax_id', '=', False)]}" type="object" string="Perbarui status" icon="fa-refresh"/>
                    <button name="action_recreate" attrs="{'invisible': ['|', ('state', 'not in', ['rejected', 'cancelled', 'error']), ('active', '=', False)]}" type="object" string="Buat ulang e-Faktur" class="btn-primary" icon="fa-repeat"/>
                    <button name="action_open_cancel_wizard" attrs="{'invisible': ['|', ('state', '!=', 'approved'), ('active', '=', False)]}" type="object" string="Batalkan e-Faktur" icon="fa-ban"
                            groups="coretax_integration.group_coretax_user"/>
                    <button name="action_request_replacement" attrs="{'invisible': ['|', '|', '|', ('state', '!=', 'approved'), ('replace_requested', '!=', False), ('replaces_id', '!=', False), ('active', '=', False)]}" type="object" string="Ganti e-Faktur" icon="fa-exchange"
                            groups="coretax_integration.group_coretax_user"
                            confirm="Buka penggantian e-Faktur ini? Faktur Odoo lalu bisa di-reset ke draft dan diperbaiki."/>
                    <button name="action_cancel_replacement" attrs="{'invisible': ['|', ('replace_requested', '=', False), ('active', '=', False)]}" type="object" string="Batalkan penggantian" icon="fa-undo"
                            groups="coretax_integration.group_coretax_user"/>
                    <button name="action_download_pdf" attrs="{'invisible': ['|', ('state', 'not in', ['approved', 'cancel_requested', 'cancelled', 'replaced']), ('aksatax_id', '=', False)]}" type="object" string="Unduh PDF Faktur Pajak" icon="fa-download"
                            groups="coretax_integration.group_coretax_user"/>
                    <button name="action_open_aksatax" attrs="{'invisible': [('aksatax_id', '=', False)]}" type="object" string="Buka di PajakMu" icon="fa-external-link"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,processing,approved"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info"><span class="o_stat_text">Faktur Odoo</span></div>
                        </button>
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Riwayat"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" attrs="{'invisible': [('active', '!=', False)]}" title="Versi lama" bg_color="text-bg-secondary"/>
                    <field name="active" invisible="1"/>
                    <field name="aksatax_id" invisible="1"/>
                    <field name="attention" invisible="1"/>
                    <field name="replace_requested" invisible="1"/>

                    <div attrs="{'invisible': [('replace_requested', '=', False)]}" class="alert alert-warning d-flex gap-2" role="status">
                        <i title="Penggantian" class="fa fa-exchange fa-lg mt-1"/>
                        <div><strong>Penggantian dibuka.</strong> Reset faktur Odoo ke draft, perbaiki, posting, lalu klik Kirim e-Faktur.</div>
                    </div>
                    <div attrs="{'invisible': [('state', '!=', 'replaced')]}" class="alert alert-secondary d-flex gap-2" role="status">
                        <i title="Diganti" class="fa fa-exchange fa-lg mt-1"/>
                        <div>e-Faktur ini sudah diganti oleh <field name="replaced_by_id" class="d-inline fw-bold" readonly="1"/>.</div>
                    </div>

                    <div attrs="{'invisible': [('state', '!=', 'approved')]}" class="alert alert-success d-flex gap-2" role="status">
                        <i title="Berhasil" class="fa fa-check-circle fa-lg mt-1"/>
                        <div>
                            <strong>Disetujui DJP.</strong> Nomor Faktur Pajak <field name="nomor_faktur" class="d-inline fw-bold" readonly="1"/>.
                            <div class="small">Untuk membatalkan faktur pajak, pakai tombol Batalkan e-Faktur di atas.</div>
                        </div>
                    </div>
                    <div attrs="{'invisible': [('state', 'not in', ['submitted', 'processing', 'cancel_requested'])]}" class="alert alert-info d-flex gap-2" role="status">
                        <i title="Sedang diproses" class="fa fa-hourglass-half fa-lg mt-1"/>
                        <div><strong>Sedang diproses DJP.</strong> Odoo memperbarui status otomatis setiap 5 menit - tidak perlu melakukan apa pun.</div>
                    </div>
                    <div attrs="{'invisible': [('state', '!=', 'pending_approval')]}" class="alert alert-warning d-flex gap-2" role="status">
                        <i title="Menunggu persetujuan" class="fa fa-hourglass-start fa-lg mt-1"/>
                        <div>
                            <strong>Menunggu persetujuan di PajakMu.</strong>
                            <span attrs="{'invisible': [('approval_step', '=', False)]}"><field name="approval_step" class="d-inline" readonly="1"/>.</span>
                            Setelah disetujui, PajakMu mengirimnya ke DJP otomatis dan Odoo memperbarui statusnya - tidak perlu
                            mengirim dari Odoo.
                            <div class="small">Faktur Odoo terkunci selama menunggu. Untuk mengubahnya, tarik dulu pengajuannya di PajakMu.</div>
                        </div>
                    </div>
                    <div attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'validated']), ('attention', '!=', False)]}" class="alert alert-warning d-flex gap-2" role="status">
                        <i title="Draft" class="fa fa-pencil-square-o fa-lg mt-1"/>
                        <div>
                            <strong>Masih draft di PajakMu.</strong> Klik <b>Kirim ke DJP</b>, atau setujui &amp; kirim dari PajakMu
                            (bila perusahaan Anda memakai alur persetujuan internal).
                        </div>
                    </div>
                    <div attrs="{'invisible': [('attention', '=', False)]}" class="alert alert-danger d-flex gap-2" role="alert">
                        <i title="Perlu tindakan" class="fa fa-exclamation-triangle fa-lg mt-1"/>
                        <div>
                            <strong>Perlu tindakan.</strong>
                            <field name="last_error" class="d-block" readonly="1"/>
                            <div class="small mt-1">
                                Perbaiki datanya (di faktur, pelanggan, atau di PajakMu), lalu klik
                                <b attrs="{'invisible': [('state', 'not in', ['rejected', 'cancelled', 'error'])]}">Buat ulang e-Faktur</b>
                                <b attrs="{'invisible': [('state', 'in', ['rejected', 'cancelled', 'error'])]}">Kirim ke DJP</b>.
                            </div>
                        </div>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="e-Faktur"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Faktur">
                            <field name="move_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="invoice_date"/>
                            <field name="amount_total"/>
                            <field name="send_mode"/>
                            <field name="replaces_id" attrs="{'invisible': [('replaces_id', '=', False)]}"/>
                            <field name="replaced_by_id" attrs="{'invisible': [('replaced_by_id', '=', False)]}"/>
                        </group>
                        <group string="Faktur Pajak (DJP)">
                            <field name="nomor_faktur"/>
                            <field name="kd_jenis_transaksi"/>
                            <label for="masa_pajak" string="Masa / tahun pajak"/>
                            <div class="o_row"><field name="masa_pajak" options="{'enable_formatting': false}"/> / <field name="tahun_pajak" options="{'enable_formatting': false}"/></div>
                            <field name="kode_approval"/>
                            <field name="tanggal_approval"/>
                            <field name="lapor_state" attrs="{'invisible': [('lapor_state', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Nilai pajak (dihitung PajakMu)">
                        <group>
                            <field name="total_dpp"/>
                            <field name="total_dpp_nilai_lain"/>
                        </group>
                        <group>
                            <field name="total_ppn"/>
                            <field name="total_ppnbm"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Info teknis" name="technical">
                            <group>
                                <group>
                                    <field name="aksatax_id" string="ID PajakMu"/>
                                    <field name="version"/>
                                    <field name="send_attempt"/>
                                </group>
                                <group>
                                    <field name="submitted_at"/>
                                    <field name="approval_step" attrs="{'invisible': [('approval_step', '=', False)]}"/>
                                    <field name="last_sync"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_coretax_faktur" model="ir.actions.act_window">
        <field name="name">Semua e-Faktur</field>
        <field name="res_model">coretax.faktur</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_coretax_faktur_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada e-Faktur</p>
            <p>Buka <b>e-Faktur › Siap dikirim</b>, pilih faktur pelanggan, lalu klik <b>Kirim e-Faktur</b>.
                Status dari DJP akan muncul di sini secara otomatis.</p>
        </field>
    </record>

    <record id="action_coretax_faktur_attention" model="ir.actions.act_window">
        <field name="name">e-Faktur perlu tindakan</field>
        <field name="res_model">coretax.faktur</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_coretax_faktur_search"/>
        <field name="context">{'search_default_attention': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tidak ada yang perlu diperbaiki</p>
            <p>Semua e-Faktur berjalan lancar. e-Faktur yang ditolak DJP atau gagal dikirim akan muncul di sini.</p>
        </field>
    </record>
</odoo>
